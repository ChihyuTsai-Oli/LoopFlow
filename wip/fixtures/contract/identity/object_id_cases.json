      "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "expect": "pass"
    },
    {
      "id": "legacy-uppercase-normalize",
      "action": "migrate",
      "value": "3FA85F64-5717-4562-B3FC-2C963F66AFA6",
      "expect": "normalize_lower",
      "normalized": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
    },
    {
      "id": "copy-must-mint-new",
      "action": "copy",
      "source_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "expect": "new_id_not_equal_source"
    },
    {
      "id": "collision-preview-mapping",
      "action": "collide",
      "existing": ["11111111-1111-4111-8111-111111111111"],
      "incoming": "11111111-1111-4111-8111-111111111111",
      "expect": "block_until_mapping",
      "mapping": {
        "old_id": "11111111-1111-4111-8111-111111111111",
        "new_id": "22222222-2222-4222-8222-222222222222"
      }
    },
    {
      "id": "rollback-restores-old",
      "action": "rollback",
      "mapping": {
        "old_id": "11111111-1111-4111-8111-111111111111",
        "new_id": "22222222-2222-4222-8222-222222222222"
      },
      "expect": "restore_old_id"
    },
    {
      "id": "silent-rebuild-forbidden",
      "action": "silent_rebuild",
      "expect": "block"
    },
